          "properties": {
            "eyebrow": {
              "description": "Small label above the title.",
              "$ref": "#/$defs/text"
            },
            "title": {
              "description": "The page title (the h1).",
              "$ref": "#/$defs/text"
            },
            "meta": {
              "description": "Short facts shown in one line, separated by dots.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "actions": {
              "description": "Up to 3 links shown as buttons: the call to action.",
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
