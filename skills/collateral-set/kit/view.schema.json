      "not": {
        "pattern": "^\\s*(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:[rR][gG][bB]|[rR][gG][bB][aA]|[hH][sS][lL]|[hH][sS][lL][aA]|[hH][wW][bB]|[lL][aA][bB]|[lL][cC][hH]|[oO][kK][lL][aA][bB]|[oO][kK][lL][cC][hH]|[cC][oO][lL][oO][rR]|[cC][oO][lL][oO][rR]-[mM][iI][xX]|[vV][aA][rR])\\(.*\\))\\s*$"
      }
    },
