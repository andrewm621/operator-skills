    "theme": {
      "description": "A Theme Core slug, or a path to a client <slug>.vars.css. Never inline colours.",
      "default": "house",
      "anyOf": [
        {
          "enum": [
            "brutalist",
            "framer",
            "house",
            "mainspring",
            "midnight-cyan",
            "obsidian",
            "paper",
            "rose-pine",
            "slate-amber",
            "verdant",
            "zero-day"
          ]
        },
        {
          "type": "string",
          "pattern": "\\.vars\\.css$"
        }
      ]
    },
    "density": {
      "description": "data-density: spacing only.",
      "enum": [
        "compact",
        "regular",
        "comfortable"
      ],
      "default": "regular"
    },
    "shell": {
      "description": "data-shell on the [data-kit] root. topbar puts view.title in a sticky bar.",
      "enum": [
        "page",
        "topbar"
      ],
      "default": "page"
    },
    "mode": {
      "description": "data-mode on <html>. auto follows prefers-color-scheme.",
      "enum": [
        "light",
        "dark",
        "auto"
      ],
      "default": "light"
    },
