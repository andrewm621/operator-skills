      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f])(?:(?:[hH][tT][tT][pP][sS]?|[mM][aA][iI][lL][tT][oO]|[tT][eE][lL]):|(?![a-zA-Z][a-zA-Z0-9+.-]*:)\\S)"
