#!/usr/bin/env python3
"""stop: terminate a process that launch-bg started (SIGTERM, then SIGKILL after 5 s).

  stop <pid>

Refuses any pid without a launch record, or whose start time, executable or bundle id no longer matches the
record (so a reused pid, or the user's own app, can never be stopped from here)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import desktop_test as dt  # noqa: E402

if len(sys.argv) != 2 or not sys.argv[1].isdigit():
    sys.exit(__doc__)
try:
    gone = dt.kill_pid(int(sys.argv[1]))
except dt.HarnessError as e:
    sys.exit(f"stop: {e}")
print("stopped" if gone else "still running after SIGKILL")
sys.exit(0 if gone else 1)
