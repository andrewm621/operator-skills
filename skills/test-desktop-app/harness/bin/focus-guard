#!/usr/bin/env python3
"""focus-guard: run a test step and prove it did not steal focus.

  focus-guard [--foreground] [--watch-pid N ...] [--watch-bundle ID ...] [--no-restore] [--log FILE] -- CMD [ARGS...]

Default (a step that CLAIMS to be background-safe): run CMD while sampling `lsappinfo front` every ~50 ms (so a
transient steal inside the step is caught, not just the state before/after), then compare.
--foreground (a step that needs real input/activation): re-check focus-mode right now; if it says `background` the
              step is NOT run (exit 3, "not run, user active"). If `foreground`, run it.

--watch-pid / --watch-bundle name the app(s) under test (use them: they are how a steal is told apart from the user
switching apps). With a watch list:
  - the front app becoming a watched app during the step is a VIOLATION in background mode (exit 4);
  - the previous app is restored only if a watched app is STILL frontmost afterwards (--no-restore disables);
  - the user switching to some other app is reported (`focus_changed`) but is neither a violation nor restored.
Without a watch list the guard cannot attribute a change: it reports `focus_changed` with `attributed: null`, does NOT
restore anything, and (in background mode) exits 5 so the run is not silently trusted.

Exit codes (the JSON line on stderr is authoritative; its `cmd_rc` is the command's real status):
  0 ok | 3 foreground step skipped (user active) | 4 focus went to a watched app in background mode (restored)
  | 5 focus changed, cause unknown (no watch list; not restored)
  | the command's own non-zero status, EXCEPT that a command status of 3, 4 or 5 is reported as 103, 104 or 105 so it
    cannot be mistaken for the guard's own codes.
"""
import argparse
import json
import os
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import desktop_test as dt  # noqa: E402

p = argparse.ArgumentParser(usage="focus-guard [options] -- CMD [ARGS...]", add_help=True)
p.add_argument("--foreground", action="store_true")
p.add_argument("--watch-pid", type=int, action="append", default=[])
p.add_argument("--watch-bundle", action="append", default=[])
p.add_argument("--no-restore", action="store_true")
p.add_argument("--log")
p.add_argument("cmd", nargs=argparse.REMAINDER)
a = p.parse_args()
cmd = a.cmd[1:] if a.cmd[:1] == ["--"] else a.cmd
if not cmd:
    p.error("missing -- CMD")

mode = dt.focus_mode()  # fresh read, right before running
before = dt.front_app()
summary = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S"), "cmd": cmd, "mode": mode, "foreground_step": a.foreground,
           "watch_pids": a.watch_pid, "watch_bundles": a.watch_bundle, "front_before": before}


def finish(code: int) -> None:
    line = json.dumps(summary)
    print("focus-guard: " + line, file=sys.stderr)
    if a.log:
        fd = os.open(a.log, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)  # never through a symlink
        with os.fdopen(fd, "a") as fh:
            fh.write(line + "\n")
    sys.exit(code)


if a.foreground and mode != "foreground":
    summary.update(result="skipped: not run, user active (or screen locked)")
    finish(3)

samples: list[dict] = []
stop = threading.Event()


def sampler():
    while not stop.is_set():
        samples.append(dt.front_app())
        stop.wait(0.05)


th = threading.Thread(target=sampler, daemon=True)
th.start()
rc = subprocess.run(cmd).returncode
time.sleep(0.3)  # let any activation settle before the last sample
stop.set()
th.join(timeout=2)
after = dt.front_app()
samples.append(after)

ev = dt.guard_evaluate(before, samples, a.watch_pid, a.watch_bundle)
summary.update(cmd_rc=rc, front_after=after, samples=len(samples), focus_changed=ev["changed"],
               to_watched_app=ev["to_watched"], attributed=ev["attributed"])
if ev["restore"] and not a.no_restore:
    summary["restored"] = dt.restore_front(before)

code = 103 if rc == 3 else 104 if rc == 4 else 105 if rc == 5 else rc
if ev["watching"] and ev["to_watched"] and mode == "background":
    summary["result"] = "VIOLATION: focus went to the app under test in background mode"
    code = 4
elif not ev["watching"] and ev["changed"] and mode == "background":
    summary["result"] = "focus changed during the step; no watch list, so not attributed and not restored"
    code = 5 if rc == 0 else code
else:
    summary["result"] = "ok" if rc == 0 else f"cmd failed rc={rc}"
finish(code)
