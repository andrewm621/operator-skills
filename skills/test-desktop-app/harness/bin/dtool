#!/usr/bin/env python3
"""dtool: run one of the on-demand Swift tools (compiled once into ~/.cache/desktop-app-testing).

  dtool winlist <pid>                         JSON list of the pid's windows (id,title,layer,x,y,w,h,onscreen,minimized)
  dtool pkey <pid> key <name> [cmd,shift,alt,ctrl]   |   dtool pkey <pid> type "<text>"      (CGEventPostToPid)
  dtool pclick <pid> <x> <y> [windowId] [count]      (CGEventPostToPid, global screen points)
  dtool pscroll <pid> <x> <y> <dy>
  dtool ax <pid> tree [depth] | press <role> <title> | set <attr> <true|false>
  dtool hidclick <x> <y>                      REAL click, foreground mode only (use under focus-guard --foreground)
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import desktop_test as dt  # noqa: E402

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    sys.exit(__doc__)
if sys.argv[1] == "hidclick":
    dt.require_foreground("hidclick")
try:
    r = dt.tool(sys.argv[1], *sys.argv[2:], check=False)
except dt.HarnessError as e:
    sys.exit(str(e))
sys.stdout.write(r.stdout)
sys.stderr.write(r.stderr)
sys.exit(r.returncode)
