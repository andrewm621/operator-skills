#!/usr/bin/env python3
"""launch-bg: start a local app WITHOUT activating it, print its PID, assert it is not frontmost.

  launch-bg <App.app | executable> [--seed-state SPEC ...] [--env K=V ...] [--stderr FILE]
            [--no-window-wait] [--allow-real-identifier] [-- APP-ARGS...]

  .app bundle  -> `open -g -n --stderr FILE [--env K=V] App.app [--args ...]`, PID found by diffing processes
                  under App.app/Contents/MacOS (so a user instance of the same app is never confused with it)
  executable   -> plain Popen in its own session, stderr to FILE (no LaunchServices)

--seed-state SPEC  SPEC = '<json-or-source-file>:<relpath>' written under ~/Library/Application Support/<bundle id>/
                   (the TEST identifier's data dir; refused if that dir exists and the harness did not create it).
Refuses: a bundle id that is not a test identifier (must contain test|probe|e2e|dev) unless
--allow-real-identifier; a bundle id that is already running. If the new app becomes frontmost during launch the
previous app is restored and the exit status is 4.

Prints one JSON line: {"pid":..,"bundle_id":..,"window":{..},"stderr":"..","front_before":{..}}.
Stop it with: kill <that pid>   (only ever PIDs you started)
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import desktop_test as dt  # noqa: E402

p = argparse.ArgumentParser(usage="launch-bg <app> [options]")
p.add_argument("app")
p.add_argument("--seed-state", action="append", default=[])
p.add_argument("--env", action="append", default=[])
p.add_argument("--stderr")
p.add_argument("--no-window-wait", action="store_true")
p.add_argument("--allow-real-identifier", action="store_true")
argv = sys.argv[1:]
app_args = []
if "--" in argv:   # everything after -- belongs to the app (argparse REMAINDER would also swallow our own options)
    i = argv.index("--")
    argv, app_args = argv[:i], argv[i + 1:]
a = p.parse_args(argv)
try:
    app = dt.launch_bg(a.app, args=app_args, env=dict(e.split("=", 1) for e in a.env), seed=a.seed_state,
                       stderr_path=a.stderr, allow_real_identifier=a.allow_real_identifier,
                       wait_window_s=None if a.no_window_wait else 15)
except dt.HarnessError as e:
    print(f"launch-bg: {e}", file=sys.stderr)
    sys.exit(4 if "frontmost" in str(e) else 1)
w = None if a.no_window_wait else app.window()
print(json.dumps({"pid": app.pid, "bundle_id": app.bundle_id, "window": w, "stderr": str(app.stderr_path),
                  "front_before": app.front_before}))
